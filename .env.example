# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# "mock" = dados de exemplo · "pluggy" = lê direto da Pluggy (sem banco ainda)
DATA_SOURCE=mock

# Supabase (públicas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Pluggy (Application no Dashboard)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=

# IA para a análise de investimentos (use UMA das opções)
# Groq (grátis): crie a chave em console.groq.com/keys
GROQ_API_KEY=
# opcional: padrão openai/gpt-oss-120b
GROQ_MODEL=
# Outra API compatível com OpenAI (Cerebras, OpenRouter…)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Claude (pago por uso)
ANTHROPIC_API_KEY=
# opcional: se vazio, usa o modelo Sonnet mais recente da sua conta
ANTHROPIC_MODEL=

# Segurança (obrigatório na Vercel)
# Senha para entrar no painel. Use uma senha longa.
APP_PASSWORD=
# Texto aleatório longo para assinar a sessão (gere com: npx --yes uuid)
AUTH_SECRET=
# Protege o cron diário (texto aleatório; a Vercel envia sozinha)
CRON_SECRET=
